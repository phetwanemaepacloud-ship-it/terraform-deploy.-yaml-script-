#AWS provider 
provider "aws" {
  region = "____"
  profile = "cloud-projects"

default_tags {
  tags = {
    "Automation"  = "terraform"
    "Project"     = "app"
    "Environment" = "dev"
}
}
}


As variables 

#AWS provider 
provider "aws" {
region = var.region
profile = "cloud-projects"

default_tags {
tags = {
"Automation" = "terraform"
"Project" = var.project_name
"Environment" = var.environment 
}
}
}



