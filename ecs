# ECS Cluster
resource "aws_ecs_cluster" "ecs_cluster" {
  name = "${var.environment}-${var.project_name}-cluster"

setting {
  name  = "containerInsights" 
  value = "disabled"
} 

  tags = {
    name = "${var.environment)-${var.project_name}-cluster"
  } 
} 

# CloudWatch Log Group
resource "aws_cloudwatch_log_group" "log_group" {
  name = "/ecs/${var.environment)-${var.project_name}-td"

    lifecycle {
      create_before_destroy = true
} 
    tags = {
      name = "${var.environment)-${var.project_name}-log-group"
    }
  }
} 

# ECS Task Definition
resource"aws_ecs_task_definition" "ecs_task_definition" {
  family                   = "${var.environment)-${var.project_name}-td"
  execution_role_arn       = var.ecs_task_role_arn
  task_role_arn            = var.ecs_task_execution_role_arn
  network mode             = "awsvpc
  requires_compatibilities = ["FARGATE"]
  cpu                      = 2048
  memory                   = 4096
} 
} 

runtime_platform {
 Voperating_system_family = "LINUX" 
  cpu_architecture        = var.architecture
}

container_definitions = jsonencode([
  {
    name          = "${var.environment}-${var.project_name}-container"
    image         = var.container_image
    essential     = true

    portMappings  = [
      {
      containerPort = 88
      hostPort = 80
      } 
    ] 

    logConfiguration = { 
      logDriver "awslogs" 
      options = {
        "awslogs-group"         = aws_cloudwatch_log_group.log_group.name
        "awslogs-region"        = var.region
        "awslogs-stream-prefix" = "ecs"
      } 
    } 
  } 
]) 

tags = {
  name = "${var.environment)-${var.project_name}-td"
}

# ECS Service
resource "aws_ecs_service" "ecs_service" {
  name                               = "${var.environment}-${var.project_name}-service
  cluster                            = aws_ecs_cluster.ecs_cluster.id
  task definition                    = aws_ecs_task_definition.ecs_task_definition.arn
  launch type                        = "FARGATE
  platform version                   = "LATEST"
  desired count                      = 1
  deployment_minimum_healthy_percent = 100
  deployment_maximum_percent         = 200
  enable_ecs_managed_tags            = true
  propagate_tags                     = "SERVICE"

# Wait for service to reach steady state before marking complete 
wait_for_steady_state = true

# Fail fast if tasks keep crashing
deployment_circuit breaker {
  enable    = true
  rollback  = true
} 

# Don't wait forever
timeouts {
  create  = "10m"
  update  = "10m"
} 

network_configuration {
subnets            = []
  security_groups  = []
  assign_public_ip = false
} 

network_configuration {
  subnets          =[]
  security_groups  = []
  assign_public_ip = false
}

load_balancer {
  target_group_arn
  container_name) = "${var.environment}-${var.project_name}-container"
  container_port  = 80
} 

  tags = {
    name = "${var.environment)-${var.project_name}-service"
 } 
} 
